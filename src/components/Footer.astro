---
import BadgeRow from "./BadgeRow.astro";
import { footerCredits, site } from "../data/site";
---

<footer id="colophon" class="relative border-t-2 border-ink">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-8 md:px-12">
    <div class="grid grid-cols-12 gap-x-4 gap-y-12">
      <div class="col-span-12 md:col-span-7">
        <p class="font-display leading-none text-ink" style="--doto-weight: 700; font-size: clamp(1.6rem, 4vw, 2.8rem);">
          THANKS FOR SCROLLING.
        </p>
        <p class="mt-4 max-w-lg font-sans text-sm leading-relaxed text-ink/75">
          You can go back to the top now.
        </p>
        <p class="mt-6 font-mono text-[11px] text-win-shadow">
          Some assets credited to:
          <a
            href={footerCredits.oldweb.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink underline decoration-1 underline-offset-2 hover:text-red"
            data-cursor="link"
            data-snd="click">{footerCredits.oldweb.label}</a
          >.
        </p>
      </div>

      <div class="col-span-12 md:col-span-5 md:justify-self-end">
        <div class="bg-face p-3 bevel">
          <p class="mb-3 font-mono text-[10px] tracking-[0.25em] text-win-shadow">SYSTEM INFO</p>
          <ul class="space-y-1.5 font-mono text-[11px] text-ink">
            <li class="flex justify-between gap-6"><span class="text-win-shadow">SITE</span><span class="font-bold">{site.name}&apos;s Cyber Nest</span></li>
            <li class="flex justify-between gap-6"><span class="text-win-shadow">TYPE</span><span class="font-bold">DOTO / GEIST / DEPARTURE MONO</span></li>
            <li class="flex justify-between gap-6"><span class="text-win-shadow">BUILT</span><span class="font-bold">2026</span></li>
          </ul>
        </div>
      </div>

      <div class="col-span-12">
        <BadgeRow />
      </div>
    </div>
  </div>

  <div class="flex h-9 items-stretch gap-px overflow-hidden bg-face bevel font-mono text-[11px] text-ink">
    <span class="flex items-center gap-2 px-3">
      <span class="inline-block h-2 w-2 bg-red" aria-hidden="true"></span>
      <span class="font-bold">{site.name.toUpperCase()}.HOME</span>
    </span>
    <span class="hidden flex-1 items-center px-3 text-win-shadow sm:flex">
      连接正常 — CONNECTION OK · MADE BY A HUMAN WHO LIKES BROWSING THE INTERNET
    </span>
    <span class="ml-auto hidden items-center px-3 tabular-nums md:flex" aria-hidden="true">ENCRYPTION: VIBES-256</span>
    <span class="flex items-center px-3">
      <span class="text-win-shadow">©</span> <span class="ml-1.5">1998—2026</span>
    </span>
  </div>
</footer>
