---
import BadgeRow from "./BadgeRow.astro";
import { footerCredits, site } from "../data/site";

interface Props {
  backHref?: string;
}

const { backHref = "#hero" } = Astro.props;
---

<footer id="colophon" class="relative border-t-2 border-ink">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-8 md:px-12">
    <div class="grid grid-cols-12 gap-x-4">
      <div class="col-span-12">
        <p class="font-display leading-none text-ink" style="--doto-weight: 700; font-size: clamp(1.6rem, 4vw, 2.8rem);">
          THANKS FOR SCROLLING.
        </p>
        <p class="mt-4 max-w-lg font-sans text-sm leading-relaxed text-ink/75">
          <a
            href={backHref}
            class="text-ink underline decoration-1 underline-offset-2 hover:text-red"
            data-cursor="link"
            data-snd="click">You can go back to the top now.</a
          >
        </p>
        <p class="mt-6 font-mono text-[11px] text-win-shadow">
          Some assets credited to:
          <a
            href={footerCredits.oldweb.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink underline decoration-1 underline-offset-2 hover:text-red"
            data-cursor="link"
            data-snd="click">{footerCredits.oldweb.label}</a
          >.
        </p>
      </div>

      <div class="col-span-12 mt-12">
        <BadgeRow />
      </div>
    </div>
  </div>

  <div class="flex h-9 items-stretch gap-px overflow-hidden bg-face bevel font-mono text-[11px] text-ink">
    <span class="flex items-center gap-2 px-3">
      <span class="inline-block h-2 w-2 bg-red" aria-hidden="true"></span>
      <span class="font-bold">{site.name.toUpperCase()}.HOME</span>
    </span>
    <span class="ml-auto flex items-center px-3">
      <span class="text-win-shadow">©</span> <span class="ml-1.5">1998—2026</span>
    </span>
  </div>
</footer>
