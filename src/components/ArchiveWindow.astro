---
import { getCollection } from "astro:content";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf(),
);
const links = await getCollection("collections");

const total = articles.length;
const bytes = JSON.stringify([articles.map((a) => a.data), links.map((l) => l.data)]).length.toLocaleString("en-US");
const latest = articles.slice(0, 3);
const stamp = (d: Date) =>
  `${String(d.getDate()).padStart(2, "0")}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getFullYear()).slice(2)}`;
---

<div id="archive-window" class="archive-window-wrap" hidden>
  <div
    id="archive-dialog"
    class="window relative flex w-full flex-col bg-face bevel"
    role="dialog"
    aria-labelledby="archive-window-title"
    data-draggable
  >
    <div class="window-titlebar flex cursor-grab items-center justify-between gap-2 bg-gradient-to-r from-navy to-navy-light px-2 py-1 select-none" data-drag-handle>
      <div class="flex min-w-0 items-center gap-2">
        <span class="inline-block h-3 w-3 shrink-0 bg-red" aria-hidden="true"></span>
        <span id="archive-window-title" class="truncate font-mono text-xs font-bold tracking-wider text-white">
          C:\CHAKERAT\ARCHIVE — 档案柜.EXE
        </span>
      </div>
      <div class="flex shrink-0 items-center gap-1">
        <button
          type="button"
          class="grid h-5 w-5 place-items-center bg-face font-mono text-[11px] leading-none text-ink bevel-thin active:bevel-thin-in"
          data-cursor="link"
          data-window-min
          aria-label="Minimize archive window"
        >
          _
        </button>
        <button
          type="button"
          class="grid h-5 w-5 place-items-center bg-face font-mono text-[11px] leading-none text-ink bevel-thin active:bevel-thin-in"
          data-cursor="link"
          data-window-max
          aria-label="Maximize archive window"
        >
          □
        </button>
        <button
          type="button"
          class="grid h-5 w-5 place-items-center bg-face font-mono text-[11px] leading-none text-ink bevel-thin hover:bg-red hover:text-white active:bevel-thin-in"
          data-cursor="link"
          data-window-close
          aria-label="Close archive window"
        >
          ✕
        </button>
      </div>
    </div>

    <div class="hidden items-center gap-4 border-b border-win-shadow px-2 py-0.5 font-mono text-[11px] md:flex select-none" aria-hidden="true">
      <span>文件(F)</span><span>编辑(E)</span><span>视图(V)</span><span>帮助(H)</span>
    </div>

    <div class="p-2 sm:p-3">
      <div class="bg-white p-4 sm:p-5 bevel-in">
        <div class="mb-4 flex items-end justify-between border-b-2 border-ink pb-3">
          <div>
            <p class="font-mono text-[10px] tracking-[0.3em] text-win-shadow">FILE LISTING — HANDLE WITH CARE</p>
            <p class="mt-1 font-display text-2xl leading-none text-ink sm:text-3xl" style="--doto-weight: 700;">
              EVERYTHING, EVENTUALLY
            </p>
          </div>
          <span class="hidden font-mono text-[10px] text-win-shadow sm:block">{total} OBJECTS</span>
        </div>

        <ul class="space-y-1">
          {
            latest.map((entry, i) => (
              <li
                class="group flex items-baseline gap-3 border-b border-dashed border-ink/15 px-1 py-2.5 font-mono text-xs transition-colors last:border-b-0 hover:bg-paper"
                data-reveal
                style={`--i:${i}`}
              >
                <span class="shrink-0 tabular-nums text-win-shadow">{stamp(entry.data.updated)}</span>
                <a
                  href={`/archive/articles/${entry.id}`}
                  class="min-w-0 truncate font-bold text-ink group-hover:text-red"
                  data-cursor="link"
                  data-snd="click"
                >
                  {entry.data.title}
                </a>
                <span class="ml-auto shrink-0 font-bold text-red">{entry.data.type.toUpperCase()}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-2 flex items-center gap-2">
        <div class="flex flex-1 items-center justify-between bg-face px-2 py-1 font-mono text-[10px] text-ink bevel-in">
          <span id="archive-status">STATUS: READY</span>
          <span aria-hidden="true">BYTES: {bytes}</span>
          <span class="font-bold text-red" aria-hidden="true">100%</span>
        </div>
        <a
          href="/archive"
          class="shrink-0 bg-face px-3 py-1.5 font-mono text-[10px] font-bold tracking-wider text-ink bevel-thin hover:bg-face-light active:bevel-thin-in"
          data-cursor="link"
          data-snd="click"
        >
          OPEN FULL ARCHIVE ►
        </a>
      </div>
    </div>

    <span class="pointer-events-none absolute top-1 left-1 font-mono text-[9px] text-white/40" aria-hidden="true">+</span>
    <span class="pointer-events-none absolute top-1 right-1 font-mono text-[9px] text-white/40" aria-hidden="true">+</span>
  </div>
</div>
