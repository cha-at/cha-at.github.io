---
import { bootLines } from "../data/site";
---

<div
  id="bootscreen"
  class="fixed inset-0 z-[var(--z-boot)] hidden flex-col items-center justify-center bg-ink text-paper"
  aria-hidden="true"
>
  <div class="w-full max-w-xl px-6 font-mono text-[12px] leading-6 sm:text-[13px]">
    <div class="mb-4 flex items-center gap-3 border-b border-white/20 pb-3">
      <span class="inline-block h-3 w-3 bg-red"></span>
      <span class="tracking-[0.25em] text-white/70">OPERATION SYSTEM / BIOS</span>
    </div>
    <div id="boot-lines" class="space-y-1">
      {
        bootLines.map((line) => (
          <p class="boot-line whitespace-pre" style={`--chars:${line.length}`}>
            {line}
          </p>
        ))
      }
    </div>
    <div class="mt-6 flex items-center justify-between border-t border-white/20 pt-3 text-white/50">
      <span>MEMORY TEST: 655,360 KB OK</span>
      <span id="boot-skip" class="text-white/80">
        SKIP<span class="animate-blink">▌</span>
      </span>
    </div>
  </div>
</div>
