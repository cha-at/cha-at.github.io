---
import { icons, type IconName } from "./StartIcons";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

<span class="shrink-0" style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg class="block" style={`width:${size}px;height:${size}px`} viewBox="0 0 16 16" shape-rendering="crispEdges" set:html={icons[name]} />
</span>
