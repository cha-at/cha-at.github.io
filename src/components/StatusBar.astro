---
import StartMenu from "./StartMenu.astro";

interface Props {
  taskLabel?: string;
  taskHref?: string;
}

const { taskLabel, taskHref = "/" } = Astro.props;
const staticTask = Boolean(taskLabel);
---

<header
  class="fixed inset-x-0 top-0 z-[var(--z-statusbar)] flex h-8 items-stretch gap-px bg-face bevel font-mono text-[11px] text-ink [view-transition-name:statusbar]"
>
  <div class="relative flex items-stretch gap-px">
    <button
      id="start-button"
      type="button"
      class="flex shrink-0 items-center gap-2 px-3 font-bold tracking-wider bevel-thin hover:bg-face-light"
      aria-haspopup="menu"
      aria-controls="start-menu"
      aria-expanded="false"
      data-cursor="link"
      data-snd="click"
    >
      <span class="inline-block h-2.5 w-2.5 bg-red" aria-hidden="true"></span>
      <span>START</span>
    </button>

    <StartMenu />
  </div>

  <a
    id="task-button"
    href={staticTask ? taskHref : "#about"}
    class:list={["max-w-72 items-center truncate px-3 bevel-thin-in hover:bg-face-light", { "is-active": staticTask }]}
    data-task-static={staticTask ? "1" : undefined}
    data-cursor="link"
    data-snd="click"
  >
    <span id="task-button-label" class="truncate">{staticTask ? taskLabel : ""}</span>
  </a>

  <span class="flex-1" aria-hidden="true"></span>

  <button
    id="snd-toggle"
    type="button"
    class="flex shrink-0 items-center gap-2 px-3 font-bold bevel-thin hover:bg-face-light"
    aria-pressed="false"
    data-cursor="link"
    title="Toggle synthesized UI sounds"
  >
    <span class="inline-block h-2 w-2 bg-win-shadow" id="snd-led"></span>
    <span id="snd-label">SND: OFF</span>
  </button>

  <span class="hidden shrink-0 items-center px-3 tabular-nums sm:flex" aria-hidden="true">
    <span id="live-clock">--:--</span>
  </span>
</header>

<style>
  #task-button {
    display: none;
  }

  @media (min-width: 640px) {
    #task-button.is-active {
      display: flex;
    }
  }
</style>
