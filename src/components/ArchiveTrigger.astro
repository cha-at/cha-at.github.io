---
import SectionHead from "./SectionHead.astro";
import ArchiveWindow from "./ArchiveWindow.astro";
import { archiveEntries } from "../data/site";
---

<section id="archive" class="relative overflow-hidden bg-teal px-4 py-16 text-white sm:px-8 md:px-12 md:py-24">
  <div class="archive-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 flex flex-col justify-center overflow-hidden opacity-[0.07]" aria-hidden="true">
    <span class="whitespace-nowrap text-right font-display uppercase leading-none" style="--doto-weight: 900; font-size: 19vw;">ARCHIVE</span>
  </div>

  <div class="relative mx-auto max-w-7xl">
    <SectionHead number="02" title="THE ARCHIVE" cn="档案柜 — KEEP FOREVER, SORT NEVER" meta="— THE DRAWER" invert />

    <div class="grid grid-cols-12 items-end gap-x-4 gap-y-10">
      <div class="col-span-12 md:col-span-7">
        <p class="max-w-xl font-sans text-xl font-bold leading-snug tracking-tight sm:text-2xl lg:text-3xl" data-reveal>
          Things I keep but refuse to throw away.
        </p>
        <p class="mt-4 max-w-lg font-sans text-sm leading-relaxed text-white/75 sm:text-base" data-reveal style="--i: 1">
          Folders inside folders since before folders inside folders were cool. Pull the drawer
          open — it floats, it drags, it accepts no apologies for its bevels.
        </p>
      </div>

      <div class="col-span-12 flex flex-wrap items-center gap-4 md:col-span-5 md:justify-end" data-reveal style="--i: 2">
        <button
          type="button"
          class="group inline-flex items-center gap-3 bg-face px-5 py-3 font-mono text-xs font-bold tracking-wider text-ink bevel transition-transform active:bevel-in active:translate-x-px active:translate-y-px"
          data-snd="open"
          data-cursor="link"
          data-open-archive
        >
          <span class="text-red" aria-hidden="true">▣</span>
          PULL THE DRAWER OUT
          <span aria-hidden="true" class="text-win-shadow transition-transform group-hover:translate-x-0.5">►</span>
        </button>
        <span class="font-mono text-[11px] text-white/60">{archiveEntries.length} ITEMS / ∞ PATIENCE</span>
      </div>
    </div>

    <div class="relative mt-14 border-t border-white/25 pt-3 font-mono text-[11px] text-white/70" data-reveal style="--i: 3">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <span>DRAWER STATUS: CLOSED</span>
        <span class="hidden sm:inline">MOUNTED AT C:\CHAKERAT\ARCHIVE</span>
        <span><span class="text-red">●</span> SAFE TO OPEN</span>
      </div>
    </div>

    <div id="archive-window-slot">
      <ArchiveWindow />
    </div>
  </div>
</section>

<style>
  .archive-grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.09) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.09) 1px, transparent 1px);
    background-size: 40px 40px;
  }
</style>
