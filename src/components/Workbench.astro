---
import { socials } from "../data/site";
import SectionHead from "./SectionHead.astro";
---

<section id="workbench" class="relative px-4 py-20 sm:px-8 md:px-12 md:py-28">
  <div class="mx-auto max-w-7xl">
    <SectionHead number="03" title="THE WORKBENCH" cn="联系 — ALL FREQUENCIES OPEN" meta="— SAY HI" />

    <div class="grid grid-cols-12 gap-x-4 gap-y-10">
      <div class="col-span-12 md:col-span-5">
        <p class="max-w-md font-sans text-xl font-bold leading-snug tracking-tight sm:text-2xl lg:text-3xl" data-reveal>
          Reach the nest.
        </p>
        <p class="mt-4 max-w-sm font-sans text-base leading-relaxed text-ink/75 sm:text-lg" data-reveal style="--i: 1">
          Best effort response time: whenever the modem finishes handshaking. Wire me about
          links, fonts, Lain, or nothing at all.
        </p>
      </div>

      <ul class="col-span-12 md:col-span-7">
        {
          socials.map((s, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a
                href={s.href}
                target={s.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={s.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                class="group flex items-center gap-4 border-b border-ink/15 py-4 transition-colors first:border-t hover:bg-ink hover:text-paper"
                data-snd="click"
                data-cursor="link"
                data-magnetic
              >
                <span class="inline-block h-3 w-3 shrink-0 bg-red" aria-hidden="true"></span>
                <span class="w-24 shrink-0 font-mono text-xs font-bold tracking-wider">{s.label}</span>
                <span class="flex-1 truncate text-right font-mono text-xs text-win-shadow group-hover:text-paper/70 sm:text-left">
                  {s.handle}
                </span>
                <span class="shrink-0 font-mono text-xs text-win-shadow transition-transform group-hover:translate-x-1 group-hover:text-red" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
